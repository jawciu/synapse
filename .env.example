# SurrealDB
SURREAL_URL=wss://your-instance.aws-euw1.surreal.cloud/rpc
SURREAL_NS=main
SURREAL_DB=main
SURREAL_USER=your_username
SURREAL_PASS=your_password

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Auth
JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-64

# Password reset email (Resend key and a sender on your verified domain)
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Optional shared rate-limit storage for multiple API workers (requires redis extra)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=hackathon
